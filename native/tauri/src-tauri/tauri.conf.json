{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Character Codex",
  "version": "0.6.4",
  "identifier": "io.github.charactercodex",
  "build": {
    "frontendDist": "../../www"
  },
  "app": {
    "windows": [
      {
        "title": "Character Codex",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Character Codex contributors",
    "copyright": "MIT License. Rules text: Open Game License v1.0a.",
    "category": "Game",
    "shortDescription": "Tabletop character sheets",
    "longDescription": "Character sheets, spells, combat tracker, notes, maps and rules lookup for the 3.5 System Reference Document.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  }
}
